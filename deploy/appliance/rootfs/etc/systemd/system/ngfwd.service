[Unit]
Description=hobby-ngfw firewall daemon
Documentation=https://github.com/stevejboyle/hobby-ngfw
# Load the ruleset before any interface comes up: no unfiltered window.
After=ngfw-firstboot.service
Before=network-pre.target
Wants=network-pre.target

[Service]
ExecStart=/usr/local/sbin/ngfwd \
    -state /var/lib/ngfw \
    -socket /run/ngfw/ngfwd.sock \
    -socket-group sjbadm \
    -api-listen :8443 \
    -api-keys /etc/ngfw/api-keys \
    -tls-cert /etc/ngfw/tls.crt \
    -tls-key /etc/ngfw/tls.key \
    -ui-listen :443 \
    -web-users /etc/ngfw/web-users \
    -users /etc/ngfw/users.json \
    -roles /etc/ngfw/roles.json \
    -hostname-dir /etc \
    -bootstrap /etc/ngfw/initial.yaml
# ngfwd opens its socket once the ruleset is loaded and the IPS and TLS
# decryption are up, which takes seconds on a loaded appliance: allow a
# minute (it used to be 5 s, which an appliance with decryption on could miss).
ExecStartPost=/bin/sh -c 'for i in $(seq 600); do [ -S /run/ngfw/ngfwd.sock ] && exit 0; sleep 0.1; done; exit 1'
TimeoutStartSec=120
# Accounts and shells for the captive CLI (idempotent; see sjb-migrate).
ExecStartPost=-/usr/local/sbin/sjb-migrate
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
