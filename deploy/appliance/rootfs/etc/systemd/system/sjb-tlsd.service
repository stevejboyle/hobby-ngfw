[Unit]
Description=SJB-OS TLS decryption (tlsd)
Documentation=https://github.com/stevejboyle/hobby-ngfw
After=ngfwd.service sjb-decrypt-net.service
# The cleartext loop: up before tlsd starts, down when tlsd stops.
Requires=sjb-decrypt-net.service
BindsTo=sjb-decrypt-net.service

[Service]
# ngfwd enables and starts this when a decryption rule decrypts, and stops
# it when none does. The ruleset hands connections to tlsd only while it
# answers (ngfwd checks every 2 s), so traffic flows undecrypted while it
# starts or is down (fail-open).
ExecStart=/usr/local/sbin/tlsd -ca /run/sjb-tlsd-ca
Restart=on-failure
RestartSec=5
SyslogIdentifier=tlsd
User=sjb-tls
Group=sjb-tls
# Transparent sockets (CAP_NET_ADMIN) and sockets in the loop's network
# namespaces (setns: CAP_SYS_ADMIN). Nothing else.
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RuntimeDirectory=sjb-tlsd
StateDirectory=sjb-tlsd
StateDirectoryMode=0700
# The CA, without opening up /etc/ngfw (root-only): only its folder,
# read-only, at /run/sjb-tlsd-ca. sjb-migrate creates the folder.
BindReadOnlyPaths=/etc/ngfw/decryption:/run/sjb-tlsd-ca
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
