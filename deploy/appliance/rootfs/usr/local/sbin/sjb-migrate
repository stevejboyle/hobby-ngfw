#!/bin/bash
# One-time (and idempotent) system setup that upgrade bundles cannot ship as
# files: accounts, groups, shells, branding. ngfwd.service runs
# `sjb-migrate` after every start; `fwctl upgrade rollback` runs
# `sjb-migrate undo TARGET` first, so a rollback to an older version gets the
# setup it expects back.
set -euo pipefail
USER_NAME="admin"
GROUP=sjbadm
SHARE=/usr/share/sjb-os
SHIM=/usr/lib/sjb-os/login-shell
SOCK=/run/ngfw/ngfwd.sock
ROOT_KEYS=/etc/ngfw/root_authorized_keys
log() { echo "sjb-migrate: $*"; }

# version_lt A B: A sorts before B (Debian version rules: 0.7.0-r01 < 0.8.0).
version_lt() { dpkg --compare-versions "$1" lt "$2"; }

apply() {
	# The CLI's admins may use ngfwd's management socket; nobody else.
	getent group "$GROUP" >/dev/null || { groupadd --system "$GROUP"; log "created group $GROUP"; }
	id -nG "$USER_NAME" | grep -qw "$GROUP" || { usermod -aG "$GROUP" "$USER_NAME"; log "$USER_NAME added to $GROUP"; }
	if [[ -S $SOCK ]]; then
		chgrp "$GROUP" "${SOCK%/*}" "$SOCK" && chmod 750 "${SOCK%/*}" && chmod 660 "$SOCK"
	fi

	# The admin's login shell is a stable shim outside the upgradable paths,
	# so its path never changes; it runs the captive CLI.
	install -d -m 755 "${SHIM%/*}"
	cat >"$SHIM.new" <<'SH'
#!/bin/sh
# Login shell of user admin: the SJB-OS captive CLI. Written by sjb-migrate.
[ -x /usr/local/sbin/sjb-cli ] && exec /usr/local/sbin/sjb-cli
echo "SJB-OS CLI missing; ask an administrator (root) to repair the appliance." >&2
exit 1
SH
	chmod 755 "$SHIM.new" && mv "$SHIM.new" "$SHIM"
	grep -qx "$SHIM" /etc/shells || echo "$SHIM" >>/etc/shells
	[[ $(getent passwd "$USER_NAME" | cut -d: -f7) == "$SHIM" ]] || { usermod -s "$SHIM" "$USER_NAME"; log "$USER_NAME now logs in to the captive CLI"; }

	# Name ngfwd's static-route protocol, so `ip route` shows "proto sjb".
	install -d -m 755 /etc/iproute2/rt_protos.d
	[[ -f /etc/iproute2/rt_protos.d/sjb.conf ]] || echo "222 sjb" >/etc/iproute2/rt_protos.d/sjb.conf

	# Branding: VMware Tools reports PRETTY_NAME to vSphere as the guest's
	# name; ID and VERSION_ID stay Debian's for apt.
	local osrel
	osrel=$(readlink -f /etc/os-release)
	if ! grep -q '^PRETTY_NAME="SJB-OS' "$osrel"; then
		sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"SJB-OS $(cat /etc/ngfw-version 2>/dev/null) (Stops Junk at the Border; Debian 13 underneath)\"/" "$osrel"
		log "os-release says SJB-OS"
	fi
	[[ -x /usr/local/sbin/ngfw-console ]] && /usr/local/sbin/ngfw-console >/dev/null 2>&1 || true

	# The IPS runs Debian's Suricata as sjb-ips.service (ngfwd starts it);
	# Debian's own unit (af-packet on eth0) must never run. Masked before
	# the package is installed, so its postinst doesn't start it either.
	if [[ ! -L /etc/systemd/system/suricata.service ]]; then
		systemctl mask --quiet suricata.service && log "Debian's suricata.service masked (SJB-OS runs sjb-ips)"
	fi

	# Debian packages shipped in the bundle install in the background, so
	# they never hold up ngfwd or an upgrade's health check.
	if compgen -G "$SHARE/packages/*.deb" >/dev/null && ! systemctl -q is-active sjb-packages; then
		systemd-run --no-block --collect --quiet --unit=sjb-packages \
			--description="SJB-OS bundled packages" /usr/local/sbin/sjb-packages || true
	fi

	# App Identification (appidd) runs from boot once a bundle has shipped it.
	if [[ -x /usr/local/sbin/appidd ]] && ! systemctl -q is-enabled appidd 2>/dev/null; then
		systemctl enable --now --no-block --quiet appidd && log "App Identification (appidd) enabled"
	fi

	# No sudo for operators.
	if id -nG "$USER_NAME" | grep -qw sudo; then gpasswd -d "$USER_NAME" sudo >/dev/null; log "$USER_NAME removed from sudo"; fi

	# Root's SSH key: from 0.9.9 on, only the one set at deploy time, in
	# /etc/ngfw (upgrades never touch it). Earlier images shipped a key in
	# $SHARE/root-keys: keep this appliance's access by moving it over, then
	# drop the shipped copy. Root's console password is whatever the
	# appliance already has (set at deploy time from 0.9.9 on).
	if [[ -f $SHARE/root-keys/authorized_keys ]]; then
		if [[ ! -s $ROOT_KEYS ]]; then
			install -m 600 "$SHARE/root-keys/authorized_keys" "$ROOT_KEYS"
			log "root SSH key moved to $ROOT_KEYS"
		fi
		rm -f "$SHARE/root-keys/authorized_keys"
		rmdir "$SHARE/root-keys" 2>/dev/null || true
	fi
}

# undo TARGET: before a rollback to version TARGET (0.8.0 or newer: bundles
# install on nothing older).
undo() {
	local target=${1:-0.0.0}
	# Every version brings its own IPS unit back up; stop ours.
	if systemctl -q is-enabled sjb-ips 2>/dev/null || systemctl -q is-active sjb-ips 2>/dev/null; then
		systemctl disable --now --quiet sjb-ips || true
		log "IPS (sjb-ips) stopped"
	fi
	# Before 0.9.9 sshd read root's key from $SHARE/root-keys: put it back.
	if version_lt "$target" 0.9.9 && [[ -s $ROOT_KEYS && ! -e $SHARE/root-keys/authorized_keys ]]; then
		install -d -m 755 "$SHARE/root-keys"
		install -m 644 "$ROOT_KEYS" "$SHARE/root-keys/authorized_keys"
		log "root SSH key put back in $SHARE/root-keys for $target"
	fi
}

case ${1:-apply} in
apply) apply ;;
undo) undo "${2:-}" ;;
finish) ;; # left over from an earlier version's timer: nothing to do
*) echo "usage: sjb-migrate [apply|undo [TARGET-VERSION]]" >&2; exit 2 ;;
esac
