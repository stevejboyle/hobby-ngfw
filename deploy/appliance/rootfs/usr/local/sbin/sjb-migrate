#!/bin/bash
# One-time (and idempotent) system setup that upgrade bundles cannot ship as
# files: accounts, groups, shells, branding. ngfwd.service runs
# `sjb-migrate` after every start; `fwctl upgrade rollback` runs
# `sjb-migrate undo TARGET` first, so a rollback to an older version gets the
# setup it expects back.
set -euo pipefail
USER_NAME="admin"
GROUP=sjbadm
SHARE=/usr/share/sjb-os
SHIM=/usr/lib/sjb-os/login-shell
SOCK=/run/ngfw/ngfwd.sock
ROOT_KEYS=/etc/ngfw/root_authorized_keys
USER_KEYS=/etc/ssh/sjb-keys
# Unix accounts ngfwd creates for SJB-OS users carry this comment.
MARKER="SJB-OS user"
# Multiple users and roles arrived in this version.
RBAC_VERSION=0.9.9-r09
# First version with port forwarding and static NAT (public addresses that
# ngfwd puts on interfaces, labelled <dev>:nat).
NAT_VERSION=0.9.9-r11
FAILLOCK="deny=5 unlock_time=900"
log() { echo "sjb-migrate: $*"; }

# version_lt A B: A sorts before B (Debian version rules: 0.7.0-r01 < 0.8.0).
version_lt() { dpkg --compare-versions "$1" lt "$2"; }

apply() {
	# The CLI's admins may use ngfwd's management socket; nobody else.
	getent group "$GROUP" >/dev/null || { groupadd --system "$GROUP"; log "created group $GROUP"; }
	id -nG "$USER_NAME" | grep -qw "$GROUP" || { usermod -aG "$GROUP" "$USER_NAME"; log "$USER_NAME added to $GROUP"; }
	if [[ -S $SOCK ]]; then
		chgrp "$GROUP" "${SOCK%/*}" "$SOCK" && chmod 750 "${SOCK%/*}" && chmod 660 "$SOCK"
	fi

	# SJB-OS users' SSH keys: ngfwd writes one root-owned file per user here;
	# sshd reads it (as the user, so the folder is world-readable).
	install -d -m 755 "$USER_KEYS"

	# SSH and console lockout: five wrong passwords in a row lock an account
	# for 15 minutes (pam_faillock; root is never locked, and admin never on
	# the VMware console). Each stack replaces Debian's common-auth include.
	if compgen -G "/usr/lib/*/security/pam_faillock.so" >/dev/null; then
		cat >/etc/pam.d/sjb-auth.new <<PAM
# SJB-OS: password check with lockout (written by sjb-migrate).
auth	required	pam_faillock.so preauth $FAILLOCK
auth	[success=1 default=bad]	pam_unix.so
auth	[default=die]	pam_faillock.so authfail $FAILLOCK
auth	sufficient	pam_faillock.so authsucc $FAILLOCK
auth	requisite	pam_deny.so
PAM
		cat >/etc/pam.d/sjb-auth-console.new <<PAM
# SJB-OS: console password check with lockout, except admin, so the VMware
# console always gets admin in (written by sjb-migrate).
auth	[success=ignore default=1]	pam_succeed_if.so quiet user = admin
auth	[success=done default=die]	pam_unix.so
auth	required	pam_faillock.so preauth $FAILLOCK
auth	[success=1 default=bad]	pam_unix.so
auth	[default=die]	pam_faillock.so authfail $FAILLOCK
auth	sufficient	pam_faillock.so authsucc $FAILLOCK
auth	requisite	pam_deny.so
PAM
		mv /etc/pam.d/sjb-auth.new /etc/pam.d/sjb-auth
		mv /etc/pam.d/sjb-auth-console.new /etc/pam.d/sjb-auth-console
		if grep -qx '@include common-auth' /etc/pam.d/sshd; then
			sed -i 's/^@include common-auth$/@include sjb-auth/' /etc/pam.d/sshd && log "SSH logins lock after 5 wrong passwords"
		fi
		if grep -qx '@include common-auth' /etc/pam.d/login; then
			sed -i 's/^@include common-auth$/@include sjb-auth-console/' /etc/pam.d/login && log "console logins lock after 5 wrong passwords (not admin)"
		fi
	else
		log "pam_faillock not found: SSH and console logins won't lock after failures"
	fi

	# The users' login shell is a stable shim outside the upgradable paths,
	# so its path never changes; it runs the captive CLI.
	install -d -m 755 "${SHIM%/*}"
	cat >"$SHIM.new" <<'SH'
#!/bin/sh
# Login shell of SJB-OS users: the captive CLI. Written by sjb-migrate.
[ -x /usr/local/sbin/sjb-cli ] && exec /usr/local/sbin/sjb-cli
echo "SJB-OS CLI missing; ask an administrator (root) to repair the appliance." >&2
exit 1
SH
	chmod 755 "$SHIM.new" && mv "$SHIM.new" "$SHIM"
	grep -qx "$SHIM" /etc/shells || echo "$SHIM" >>/etc/shells
	[[ $(getent passwd "$USER_NAME" | cut -d: -f7) == "$SHIM" ]] || { usermod -s "$SHIM" "$USER_NAME"; log "$USER_NAME now logs in to the captive CLI"; }

	# Name ngfwd's static-route protocol, so `ip route` shows "proto sjb".
	install -d -m 755 /etc/iproute2/rt_protos.d
	[[ -f /etc/iproute2/rt_protos.d/sjb.conf ]] || echo "222 sjb" >/etc/iproute2/rt_protos.d/sjb.conf

	# Branding: VMware Tools reports PRETTY_NAME to vSphere as the guest's
	# name; ID and VERSION_ID stay Debian's for apt.
	local osrel
	osrel=$(readlink -f /etc/os-release)
	if ! grep -q '^PRETTY_NAME="SJB-OS' "$osrel"; then
		sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"SJB-OS $(cat /etc/ngfw-version 2>/dev/null) (Stops Junk at the Border; Debian 13 underneath)\"/" "$osrel"
		log "os-release says SJB-OS"
	fi
	[[ -x /usr/local/sbin/ngfw-console ]] && /usr/local/sbin/ngfw-console >/dev/null 2>&1 || true

	# The IPS runs Debian's Suricata as sjb-ips.service (ngfwd starts it);
	# Debian's own unit (af-packet on eth0) must never run. Masked before
	# the package is installed, so its postinst doesn't start it either.
	if [[ ! -L /etc/systemd/system/suricata.service ]]; then
		systemctl mask --quiet suricata.service && log "Debian's suricata.service masked (SJB-OS runs sjb-ips)"
	fi

	# Debian packages shipped in the bundle install in the background, so
	# they never hold up ngfwd or an upgrade's health check.
	if compgen -G "$SHARE/packages/*.deb" >/dev/null && ! systemctl -q is-active sjb-packages; then
		systemd-run --no-block --collect --quiet --unit=sjb-packages \
			--description="SJB-OS bundled packages" /usr/local/sbin/sjb-packages || true
	fi

	# App Identification (appidd) runs from boot once a bundle has shipped it.
	if [[ -x /usr/local/sbin/appidd ]] && ! systemctl -q is-enabled appidd 2>/dev/null; then
		systemctl enable --now --no-block --quiet appidd && log "App Identification (appidd) enabled"
	fi

	# TLS decryption: tlsd runs as sjb-tls, which alone can read the CA's
	# key in /etc/ngfw/decryption (ngfwd writes it there).
	if ! getent passwd sjb-tls >/dev/null; then
		useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sjb-tls
		log "created user sjb-tls (TLS decryption)"
	fi
	# The CA folder always exists: sjb-tlsd.service bind-mounts it (read-only)
	# into tlsd's sandbox, since /etc/ngfw itself stays root-only.
	install -d -m 750 -o root -g sjb-tls /etc/ngfw/decryption
	chown root:sjb-tls /etc/ngfw/decryption && chmod 750 /etc/ngfw/decryption
	for k in /etc/ngfw/decryption/*.key; do
		[[ -f $k ]] && chown sjb-tls:sjb-tls "$k" && chmod 600 "$k"
	done

	# No sudo for operators.
	if id -nG "$USER_NAME" | grep -qw sudo; then gpasswd -d "$USER_NAME" sudo >/dev/null; log "$USER_NAME removed from sudo"; fi

	# Root's SSH key: from 0.9.9 on, only the one set at deploy time, in
	# /etc/ngfw (upgrades never touch it). Earlier images shipped a key in
	# $SHARE/root-keys: keep this appliance's access by moving it over, then
	# drop the shipped copy. Root's console password is whatever the
	# appliance already has (set at deploy time from 0.9.9 on).
	if [[ -f $SHARE/root-keys/authorized_keys ]]; then
		if [[ ! -s $ROOT_KEYS ]]; then
			install -m 600 "$SHARE/root-keys/authorized_keys" "$ROOT_KEYS"
			log "root SSH key moved to $ROOT_KEYS"
		fi
		rm -f "$SHARE/root-keys/authorized_keys"
		rmdir "$SHARE/root-keys" 2>/dev/null || true
	fi
}

# undo TARGET: before a rollback to version TARGET (0.8.0 or newer: bundles
# install on nothing older).
undo() {
	local target=${1:-0.0.0}
	# Every version brings its own IPS unit back up; stop ours.
	if systemctl -q is-enabled sjb-ips 2>/dev/null || systemctl -q is-active sjb-ips 2>/dev/null; then
		systemctl disable --now --quiet sjb-ips || true
		log "IPS (sjb-ips) stopped"
	fi
	# Stop TLS decryption (and take its loop down) before any rollback:
	# versions before 0.9.9-r04 don't have it, and later ones start it
	# again themselves when their config decrypts.
	if systemctl -q is-enabled sjb-tlsd 2>/dev/null || systemctl -q is-active sjb-tlsd 2>/dev/null; then
		systemctl disable --now --quiet sjb-tlsd || true
		log "TLS decryption (sjb-tlsd) stopped"
	fi
	# Before multiple users, only admin may log in: lock every other SJB-OS
	# user's login (older versions would give them full rights through
	# sjbadm), give admin's SSH keys back to its home folder (where older
	# versions' sshd looks) and take the lockout out of PAM. Upgrading again
	# brings them back (ngfwd re-enables the users at start).
	if version_lt "$target" "$RBAC_VERSION"; then
		local u
		while IFS=: read -r u _ _ _ gecos _; do
			[[ $gecos == "$MARKER" ]] || continue
			usermod --lock --expiredate 1 -- "$u" >/dev/null 2>&1 || true
			gpasswd --delete "$u" "$GROUP" >/dev/null 2>&1 || true
			loginctl terminate-user "$u" >/dev/null 2>&1 || true
			log "SJB-OS user $u locked for $target (only admin can log in there)"
		done </etc/passwd
		local home
		home=$(getent passwd "$USER_NAME" | cut -d: -f6)
		if [[ -n $home && -d $home ]]; then
			install -d -m 700 -o "$USER_NAME" -g "$USER_NAME" "$home/.ssh"
			if [[ -s $USER_KEYS/$USER_NAME ]]; then
				install -m 600 -o "$USER_NAME" -g "$USER_NAME" "$USER_KEYS/$USER_NAME" "$home/.ssh/authorized_keys"
			else
				rm -f "$home/.ssh/authorized_keys"
			fi
			log "admin's SSH keys put back in $home/.ssh for $target"
		fi
		sed -i 's/^@include sjb-auth$/@include common-auth/' /etc/pam.d/sshd
		sed -i 's/^@include sjb-auth-console$/@include common-auth/' /etc/pam.d/login
		rm -f /etc/pam.d/sjb-auth /etc/pam.d/sjb-auth-console
	fi
	# Before inbound NAT, nothing removes the public addresses ngfwd put on
	# interfaces for published servers: take them off now.
	if version_lt "$target" "$NAT_VERSION"; then
		local dev addr
		while read -r dev addr; do
			ip -4 addr del "$addr" dev "$dev" 2>/dev/null && log "NAT public address $addr removed from $dev for $target"
		done < <(ip -4 -o addr show 2>/dev/null | awk '{d = $2; sub(/@.*/, "", d); for (i = 5; i <= NF; i++) { t = $i; sub(/\\$/, "", t); if (t == d ":nat" || t == d ":n") print d, $4 } }')
	fi
	# Before 0.9.9 sshd read root's key from $SHARE/root-keys: put it back.
	if version_lt "$target" 0.9.9 && [[ -s $ROOT_KEYS && ! -e $SHARE/root-keys/authorized_keys ]]; then
		install -d -m 755 "$SHARE/root-keys"
		install -m 644 "$ROOT_KEYS" "$SHARE/root-keys/authorized_keys"
		log "root SSH key put back in $SHARE/root-keys for $target"
	fi
}

case ${1:-apply} in
apply) apply ;;
undo) undo "${2:-}" ;;
finish) ;; # left over from an earlier version's timer: nothing to do
*) echo "usage: sjb-migrate [apply|undo [TARGET-VERSION]]" >&2; exit 2 ;;
esac
