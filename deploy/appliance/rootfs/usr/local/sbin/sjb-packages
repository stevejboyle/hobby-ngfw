#!/bin/bash
# Install the Debian packages an upgrade bundle carries in
# /usr/share/sjb-os/packages: what SJB-OS needs (FRR, Kea, Suricata, snmpd)
# and Debian's security and point-release updates, the kernel included.
# fwctl installs only what is missing or older (never a downgrade), first
# saving the installed versions so `fwctl upgrade rollback` can put them
# back, and records the result for `fwctl upgrade status`. Safe to run
# often: sjb-migrate starts it in the background whenever ngfwd starts.
exec /usr/local/sbin/fwctl packages install
