	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct mark and 0x4000 == 0x4000 drop comment "app-identification: denied once identified"
		ct state established ct mark and 0x2000 == 0x2000 accept
		ct state established ct direction reply accept
		ct state related ct mark set ct mark or 0x2000 accept
		ct state invalid drop
		iifname "inside" oifname "outside" ct mark and 0x7ff { 32, 59, 61, 124, 133, 189, 195, 202, 450 } counter log prefix "ngfw no-streaming deny " ct mark set ct mark or 0x4000 drop comment "rule:no-streaming"
		iifname "inside" oifname "outside" ct mark and 0x7ff { 24, 55, 79, 115, 116, 117, 159, 161, 163, 206, 209, 215, 259, 277, 290, 299, 300, 303, 304, 339, 344, 348, 384, 426, 427, 428, 429, 444, 445, 451, 454, 476, 477, 487, 488 } counter log prefix "ngfw no-vpns deny " ct mark set ct mark or 0x4000 drop comment "rule:no-vpns"
		iifname "inside" oifname "outside" meta l4proto tcp ct mark and 0x7ff == 37 counter log prefix "ngfw no-p2p reset " ct mark set ct mark or 0x4000 reject with tcp reset comment "rule:no-p2p"
		iifname "inside" oifname "outside" ct mark and 0x7ff == 37 counter log prefix "ngfw no-p2p reset " ct mark set ct mark or 0x4000 reject with icmpx type admin-prohibited comment "rule:no-p2p"
		iifname "inside" oifname "outside" ct mark and 0x8000 == 0 log prefix "ngfw inside-out allow " ct mark set ct mark or 0x8000
		iifname "inside" oifname "outside" counter ct mark set ct mark and 0x0000f7ff or 0x00040800 jump allowed comment "rule:inside-out"
		counter comment "default-deny"
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iif lo accept
		ct state established,related accept
		ct state invalid drop
		iifname { "inside", "outside" } meta l4proto icmp accept
		iifname { "inside", "outside" } counter drop comment "zone-to-firewall"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		iifname "inside" oifname "outside" counter masquerade comment "nat:out"
	}
