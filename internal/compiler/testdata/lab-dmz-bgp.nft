	chain ips {
		type filter hook forward priority filter + 10; policy accept;
		meta nfproto ipv4 ct mark and 0xffff0000 { 0x00030000, 0x00050000, 0x00060000, 0x00070000, 0x000d0000 } queue flags bypass,fanout to 2-3 comment "ips"
	}

	chain ips_p0 {
		comment "ips profile enterprise"
		meta mark and 0x01000000 != 0 ct mark set ct mark or 0x4000 counter drop comment "ips:enterprise critical"
		meta mark and 0x02000000 != 0 ct mark set ct mark or 0x4000 counter drop comment "ips:enterprise major"
	}

	chain ips_enforce {
		type filter hook forward priority filter + 20; policy accept;
		meta mark and 0x0f000000 == 0 accept
		ct mark and 0xffff0000 vmap { 0x00030000 : jump ips_p0, 0x00050000 : jump ips_p0, 0x00060000 : jump ips_p0, 0x00070000 : jump ips_p0, 0x000d0000 : jump ips_p0 }
		meta mark set meta mark and 0xf0ffffff
	}

